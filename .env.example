# Public canonical origin, e.g. https://www.andhrarootskitchen.in
NEXT_PUBLIC_SITE_URL=

# Admin authentication (PBKDF2 value: iterations.salt.hash) and HMAC secret
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Cloudflare D1 HTTP API (server-only)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Cloudflare R2 S3 API (server-only)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Google Places API (server-only)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
