# Public canonical origin, e.g. https://www.chettukindapesarattu.in
NEXT_PUBLIC_SITE_URL=

# Admin authentication. Set ONE password option; ADMIN_PASSWORD_HASH is safer.
# ADMIN_PASSWORD may be a 16+ character random password stored only in Vercel.
ADMIN_PASSWORD=
# PBKDF2 value: iterations.salt.hash (base64url salt and hash)
ADMIN_PASSWORD_HASH=
# Optional but recommended as an independent cookie-signing key.
# Generate with `openssl rand -base64 48`. If omitted, the password credential
# is securely derived into a signing key so ADMIN_PASSWORD alone still works.
ADMIN_SESSION_SECRET=

# Neon Postgres pooled connection string (server-only)
DATABASE_URL=

# Cloudflare R2 S3 API (server-only)
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Google Places API (server-only)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
